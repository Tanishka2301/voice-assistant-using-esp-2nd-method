#include <WiFi.h>
#include <WebServer.h>
#include <WiFiClientSecure.h>
#include <HTTPClient.h>
// ==================================================
// 1. WIFI SETTINGS
// ==================================================

const char* WIFI_SSID = "Redmi Note 9 Pro";
const char* WIFI_PASSWORD = "qwertyuiop";

// =====================================================
// 2. GEMINI SETTINGS
// =====================================================

const char* GEMINI_API_KEY = "- - write your own api key";
const char* GEMINI_MODEL = "gemini-3.8-flash";
// ==================================================
// 3. SERVER
// ==================================================

WebServer server(8000);

// ==================================================
// 4. FIND THE AUDIO FIELD IN THE INCOMING JSON
// ==================================================

String extractAudio(String body) {
  int keyPosition = body.indexOf("\"audio\"");
  if (keyPosition < 0) {
    return "";
  }

  int colonPosition = body.indexOf(':', keyPosition);
  if (colonPosition < 0) {
    return "";
  }

  int start = body.indexOf('"', colonPosition + 1);
  if (start < 0) {
    return "";
  }

  int end = body.indexOf('"', start + 1);
  if (end < 0) {
    return "";
  }

  return body.substring(start + 1, end);
}

// ==================================================
// 5. SEND AUDIO TO GEMINI
// ==================================================

String askGemini(const String& audioBase64) {
  WiFiClientSecure tls;

  // Prototype only. This disables TLS certificate checking.
  // Do not use this setting in a production system.
  tls.setInsecure();

  HTTPClient http;

  String url =
      String("https://generativelanguage.googleapis.com/v1beta/models/")
      + GEMINI_MODEL + ":generateContent";

  Serial.println("Connecting to Gemini...");

  if (!http.begin(tls, url)) {
    Serial.println("Could not start HTTPS connection.");
    return "";
  }

  http.setTimeout(180000);

  // Send the API key in the recommended header.
  http.addHeader("Content-Type", "application/json");
  http.addHeader("x-goog-api-key", GEMINI_API_KEY);

  // Build a JSON request containing the WAV audio.
  String requestBody;
  requestBody.reserve(audioBase64.length() + 500);

  requestBody =
      "{\"contents\":[{\"parts\":["
      "{\"text\":\"Listen to this audio. Understand the user's "
      "spoken request and answer it directly. If the speech is "
      "unclear, ask the user to repeat it.\"},"
      "{\"inline_data\":{\"mime_type\":\"audio/wav\",\"data\":\"";

  requestBody += audioBase64;

  requestBody +=
      "\"}}]}],"
      "\"generationConfig\":{\"temperature\":0.4}}";

  Serial.printf("Gemini request size: %u bytes\n",
                (unsigned int)requestBody.length());

  int httpCode = http.POST(
      (uint8_t*)requestBody.c_str(),
      requestBody.length()
  );

  String response = http.getString();

  Serial.printf("Gemini HTTP status: %d\n", httpCode);

  if (httpCode < 200 || httpCode >= 300) {
    Serial.println("Gemini returned an error:");
    Serial.println(response);
    http.end();
    return "";
  }

  http.end();

  // Extract the generated text from Gemini's JSON response.
  // This lightweight extraction handles ordinary text responses.
  int textPosition = response.indexOf("\"text\"");
  if (textPosition < 0) {
    Serial.println("No response text found in Gemini JSON.");
    Serial.println(response);
    return "";
  }

  int colonPosition = response.indexOf(':', textPosition);
  int startQuote = response.indexOf('"', colonPosition + 1);

  if (startQuote < 0) {
    return "";
  }

  String answer;
  bool escaped = false;

  for (int i = startQuote + 1; i < response.length(); i++) {
    char c = response[i];

    if (escaped) {
      switch (c) {
        case 'n': answer += '\n'; break;
        case 'r': answer += '\r'; break;
        case 't': answer += '\t'; break;
        case '"': answer += '"'; break;
        case '\\': answer += '\\'; break;
        case '/': answer += '/'; break;
        default:
          answer += '\\';
          answer += c;
          break;
      }

      escaped = false;
      continue;
    }

    if (c == '\\') {
      escaped = true;
      continue;
    }

    if (c == '"') {
      break;
    }

    answer += c;
  }

  return answer;
}

// ==================================================
// 6. RECEIVE AUDIO FROM THE LAPTOP
// ==================================================

void handleAudio() {
  Serial.println("\nAudio request received from laptop.");

  if (!server.hasArg("plain")) {
    server.send(400, "application/json",
                "{\"error\":\"Missing JSON request body\"}");
    return;
  }

  String body = server.arg("plain");

  Serial.printf("Received body length: %u bytes\n",
                (unsigned int)body.length());

  String audioBase64 = extractAudio(body);

  // Release the original JSON body to save memory.
  body = "";

  if (audioBase64.length() == 0) {
    Serial.println("Could not find audio field.");
    server.send(400, "application/json",
                "{\"error\":\"Missing or invalid audio field\"}");
    return;
  }

  Serial.printf("Audio Base64 length: %u characters\n",
                (unsigned int)audioBase64.length());

  String answer = askGemini(audioBase64);

  if (answer.length() == 0) {
    server.send(502, "application/json",
                "{\"error\":\"Gemini request failed; check Serial Monitor\"}");
    return;
  }

  // Return a JSON response to the laptop.
  // ArduinoJson is needed to escape quotes and newlines safely.
  String escapedAnswer;
  escapedAnswer.reserve(answer.length() + 100);

  for (unsigned int i = 0; i < answer.length(); i++) {
    char c = answer[i];

    if (c == '"') {
      escapedAnswer += "\\\"";
    } else if (c == '\\') {
      escapedAnswer += "\\\\";
    } else if (c == '\n') {
      escapedAnswer += "\\n";
    } else if (c == '\r') {
      escapedAnswer += "\\r";
    } else if (c == '\t') {
      escapedAnswer += "\\t";
    } else if ((uint8_t)c >= 0x20) {
      escapedAnswer += c;
    }
  }

  String output = "{\"text\":\"" + escapedAnswer + "\"}";

  server.send(200, "application/json", output);

  Serial.println("Answer sent to laptop:");
  Serial.println(answer);
}

// ==================================================
// 7. START ESP32
// ==================================================

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("\nESP32-S3 Gemini Voice Assistant");
  Serial.println("Connecting to Wi-Fi...");

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED && attempts < 40) {
    delay(500);
    Serial.print(".");
    attempts++;
  }

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("\nWi-Fi connection failed.");
    return;
  }

  Serial.println("\nWi-Fi connected!");
  Serial.print("ESP32 IP address: ");
  Serial.println(WiFi.localIP());

  server.on("/", HTTP_GET, []() {
    server.send(200, "application/json",
                "{\"status\":\"ESP32 voice assistant is online\"}");
  });

  server.on("/audio", HTTP_POST, handleAudio);

  server.begin();

  Serial.println("HTTP server started on port 8000.");
  Serial.println("Ready to receive audio from the laptop.");
}

// ==================================================
// 8. KEEP SERVER RUNNING
// ==================================================

void loop() {
  if (WiFi.status() != WL_CONNECTED) {
    WiFi.reconnect();
  }

  server.handleClient();
}
